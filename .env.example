PORT=3000

# Koneksi PostgreSQL (password database ada di sini)
DATABASE_URL=postgres://postgres:ganti_password_ini@localhost:5432/mini_mes

# Zona waktu untuk batas "hari ini" (output & reject hari ini)
TIMEZONE=Asia/Jakarta

# Mesin dianggap OFFLINE jika tidak ada data lebih dari N detik
OFFLINE_AFTER_SECONDS=30

# Device key per mesin, dipakai tools/sim-device.js.
# Harus sama dengan kolom machines.device_key di database (lihat db/seed.sql).
DEVICE_KEY_MC01=dev-key-mc01
DEVICE_KEY_MC02=dev-key-mc02
DEVICE_KEY_MC03=dev-key-mc03

# Alamat backend untuk simulator
SIM_BASE_URL=http://localhost:3000
